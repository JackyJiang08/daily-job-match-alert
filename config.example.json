{
  "lookbackHours": 24,
  "timeZone": "America/Chicago",
  "reportDateOffsetDays": 1,
  "minimumMatchScore": 70,
  "requireFullDescription": true,
  "minimumDescriptionCharacters": 200,
  "semanticMatching": {
    "engine": "claude",
    "claudeCommand": "claude",
    "codexCommand": "codex",
    "model": "fable",
    "models": { "claude": "fable", "codex": "gpt-5.6-sol" },
    "required": true,
    "batchSize": 6,
    "maximumDescriptionCharacters": 7000,
    "acceptedMatchLevels": ["high"],
    "maxReviewedPerRun": 120,
    "quotaPolicy": {
      "fiveHourLimit": { "retryIntervalMs": 600000, "maxWaitMs": 5400000 },
      "modelLadder": ["fable", "opus"],
      "fallbackEngine": null,
      "patternsNote": "Optional regex overrides per class (fiveHourLimit, modelWeeklyLimit, accountWeeklyLimit, notQuota, genericLimit); see src/engines/quota.mjs for the recorded defaults."
    },
    "timeoutMs": 600000
  },
  "reports": {
    "xlsx": {
      "enabled": true,
      "required": false
    }
  },
  "outputDirectory": "~/Desktop/Daily Job Match Alert",
  "coverLetter": {
    "fileNameTemplate": "{FirstLast}_Cover_Letter_{Company}.pdf",
    "editorReview": true
  },
  "hub": {
    "port": 4747,
    "chromeCommand": "",
    "modelChoicesNote": "Options for the Settings page model dropdown; append your own entries (value = name passed to the CLI).",
    "modelChoices": {
      "claude": [
        { "value": "fable", "label": "Fable (recommended)" },
        { "value": "opus", "label": "Opus" },
        { "value": "sonnet", "label": "Sonnet" },
        { "value": "haiku", "label": "Haiku" }
      ],
      "codex": [
        { "value": "gpt-5.6-sol", "label": "gpt-5.6-sol (Codex default)" }
      ]
    }
  },
  "resumes": {
    "autoRefresh": true,
    "pdftotextCommand": "pdftotext",
    "tracks": [
      { "id": "data", "label": "Data", "pdf": "~/Desktop/Your Data Resume.pdf", "enabled": true },
      { "id": "llm", "label": "LLM", "pdf": "~/Desktop/Your LLM Resume.pdf", "enabled": true },
      { "id": "agent", "label": "AI Agent", "pdf": "~/Desktop/Your AI Agent Resume.pdf", "enabled": true }
    ]
  },
  "preferences": {
    "roleTypes": ["internship", "new_grad", "entry_level"],
    "locations": ["United States", "USA", "Remote - US"],
    "locationPolicy": "United States only, including remote roles that permit work from the USA",
    "remoteOkay": true,
    "maxYearsExperience": 3,
    "needsSponsorship": false,
    "graduationDate": "2027-05",
    "excludeTitleTerms": ["senior", "staff", "principal", "manager", "director", "lead"]
  },
  "sources": {
    "simplifyInternships": {
      "enabled": true,
      "url": "https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/README.md"
    },
    "simplifyNewGrad": {
      "enabled": true,
      "url": "https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/README.md"
    },
    "githubLists": {
      "enabled": true,
      "listsNote": "Community posting lists read from each repository's raw README (public repositories, no token). Switch one off with enabled: false; url overrides the README location.",
      "lists": {
        "jobrightDataAnalysisInternship": { "enabled": true },
        "jobrightDataAnalysisNewGrad": { "enabled": true },
        "jobrightSoftwareEngineerInternship": { "enabled": true },
        "jobrightSoftwareEngineerNewGrad": { "enabled": true },
        "vanshInternships": { "enabled": true },
        "vanshNewGrad": { "enabled": true },
        "zapplyInternships": { "enabled": true },
        "zapplyNewGrad": { "enabled": true },
        "zapplyMlInternships": { "enabled": true },
        "zapplyNewGradDataScience": { "enabled": true },
        "zshahTechInternships": { "enabled": true }
      }
    },
    "hackerNewsHiring": {
      "enabled": true,
      "note": "The monthly Ask HN: Who is hiring? thread through the public Algolia HN Search API; only posts that mention intern, new grad, entry level, or junior are kept."
    },
    "remoteOk": {
      "enabled": true,
      "note": "RemoteOK's public JSON feed; only remote postings open to the United States with an early-career title or tag are kept, and each card links back to the posting on remoteok.com as its terms ask."
    },
    "emailFiles": {
      "enabled": true,
      "directory": "./intake/eml"
    },
    "himalaya": {
      "enabled": false,
      "account": "personal",
      "folder": "job-alerts",
      "pageSize": 100
    },
    "careerOps": {
      "enabled": false,
      "projectDirectory": "../../work/career-ops",
      "scanHistoryPath": "../../work/career-ops/data/scan-history.tsv",
      "runScanFirst": false
    },
    "atsBoards": {
      "enabled": true,
      "minimumPollIntervalHours": 20,
      "maximumWorkdayPages": 10,
      "boardsNote": "Boards are discovered from posting URLs automatically and kept in state/ats-boards.json; list one here to add it by hand or to switch it off. key forms: greenhouse:<token>, lever:<company>, ashby:<org>, workday:<tenant>/<site>@<tenant>.wd5.myworkdayjobs.com; url accepts a board front page or any posting on it.",
      "boards": [
        { "url": "https://job-boards.greenhouse.io/examplecorp", "company": "Example Corp", "enabled": false }
      ]
    }
  },
  "network": {
    "fetchDescriptions": true,
    "concurrency": 3,
    "timeoutMs": 15000,
    "userAgent": "DailyJobMatchAlert/0.1 (+personal job search; respectful daily polling)"
  }
}
