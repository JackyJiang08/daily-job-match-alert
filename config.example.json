{
  "lookbackHours": 24,
  "timeZone": "America/Chicago",
  "reportDateOffsetDays": 1,
  "minimumMatchScore": 70,
  "requireFullDescription": true,
  "minimumDescriptionCharacters": 200,
  "semanticMatching": {
    "engine": "claude_subscription",
    "claudeCommand": "claude",
    "model": "fable",
    "required": true,
    "batchSize": 6,
    "maximumDescriptionCharacters": 7000,
    "acceptedMatchLevels": ["high"],
    "timeoutMs": 600000
  },
  "reports": {
    "xlsx": {
      "enabled": true,
      "required": false
    }
  },
  "outputDirectory": "~/Desktop/Daily Job Match Alert",
  "resumes": {
    "autoRefresh": true,
    "pdftotextCommand": "pdftotext",
    "tracks": [
      { "id": "data", "label": "Data", "pdf": "~/Desktop/Your Data Resume.pdf", "enabled": true },
      { "id": "llm", "label": "LLM", "pdf": "~/Desktop/Your LLM Resume.pdf", "enabled": true },
      { "id": "agent", "label": "AI Agent", "pdf": "~/Desktop/Your AI Agent Resume.pdf", "enabled": true }
    ]
  },
  "preferences": {
    "roleTypes": ["internship", "new_grad", "entry_level"],
    "locations": ["United States", "USA", "Remote - US"],
    "locationPolicy": "United States only, including remote roles that permit work from the USA",
    "remoteOkay": true,
    "maxYearsExperience": 3,
    "needsSponsorship": false,
    "graduationDate": "2027-05",
    "excludeTitleTerms": ["senior", "staff", "principal", "manager", "director", "lead"]
  },
  "sources": {
    "simplifyInternships": {
      "enabled": true,
      "url": "https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/README.md"
    },
    "simplifyNewGrad": {
      "enabled": true,
      "url": "https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/README.md"
    },
    "emailFiles": {
      "enabled": true,
      "directory": "./intake/eml"
    },
    "himalaya": {
      "enabled": false,
      "account": "personal",
      "folder": "job-alerts",
      "pageSize": 100
    },
    "careerOps": {
      "enabled": false,
      "projectDirectory": "../../work/career-ops",
      "scanHistoryPath": "../../work/career-ops/data/scan-history.tsv",
      "runScanFirst": false
    }
  },
  "network": {
    "fetchDescriptions": true,
    "concurrency": 3,
    "timeoutMs": 15000,
    "userAgent": "DailyJobMatchAlert/0.1 (+personal job search; respectful daily polling)"
  }
}
