{
  "name": "daily-job-match-alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nightly job-match agent: collects public internship and new-grad postings, scores them against your resume tracks with your Claude or ChatGPT subscription, and drafts one-page cover letters from a local hub. No API keys, no auto-apply.",
  "author": "Yuqing (Jacky) Jiang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackyJiang08/daily-job-match-alert.git"
  },
  "keywords": [
    "job-search",
    "automation",
    "agent",
    "claude-code",
    "codex",
    "node",
    "launchd",
    "resume-matching",
    "cover-letter",
    "greenhouse",
    "workday",
    "macos"
  ],
  "scripts": {
    "run": "node src/index.mjs --config config.json",
    "run:catchup": "node src/catchup.mjs --config config.json",
    "resume:sync": "node src/resume-sync-cli.mjs --config config.json",
    "hub": "node src/hub/index.mjs --config config.json",
    "hub:restart": "sh scripts/hub-restart.sh",
    "test": "node --test tests/*.test.mjs",
    "demo": "node src/index.mjs --config tests/fixtures/config.demo.json --now 2026-08-27T12:00:00Z",
    "chaos": "bash scripts/chaos-check.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
