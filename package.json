{
  "name": "daily-job-match-alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, subscription-only AI job discovery for internships and new-grad roles, scored against any number of resume tracks",
  "author": "Yuqing (Jacky) Jiang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackyJiang08/daily-job-match-alert.git"
  },
  "keywords": [
    "job-search",
    "career",
    "automation",
    "claude-code",
    "data-science",
    "machine-learning",
    "new-grad",
    "internships"
  ],
  "scripts": {
    "run": "node src/index.mjs --config config.json",
    "run:catchup": "node src/catchup.mjs --config config.json",
    "resume:sync": "node src/resume-sync-cli.mjs --config config.json",
    "test": "node --test tests/*.test.mjs",
    "demo": "node src/index.mjs --config tests/fixtures/config.demo.json --now 2026-08-27T12:00:00Z",
    "chaos": "bash scripts/chaos-check.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
